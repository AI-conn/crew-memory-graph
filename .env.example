# Backend selection: "memory" = in-memory DEV backend (snapshot-persisted,
# labeled in the UI). For the real deployment use FalkorDB:
APP_GRAPH_BACKEND=falkordb

# FalkorDB connection (Cloud free tier or self-hosted). For FalkorDB Cloud,
# use the host/port/credentials from your instance page.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Graph names are per-tenant: <GRAPH_PREFIX>_<tenant>
GRAPH_PREFIX=crewmem
DEFAULT_TENANT=meridian

# Web server port
PORT=7860

# Optional: Nebius Token Factory inference (powers POST /api/ask_llm —
# per-role model routing, see crew_memory/inference.py). Without this key
# the app runs normally and /api/ask_llm returns 503.
NEBIUS_TOKEN_FACTORY_API_KEY=
